# ==============================================================================
# YANA - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env with actual API keys or secrets to version control.
# ==============================================================================

# --- Application Environment ---
# Options: development, staging, production
YANA_ENV=development
YANA_DEBUG=true

# --- Agent Service Settings ---
YANA_AGENT_HOST=127.0.0.1
YANA_AGENT_PORT=8765
YANA_AGENT_LOG_LEVEL=INFO
# Path for SQLite database storage
YANA_STORAGE_PATH=./data/yana.db

# --- AI Provider Configuration ---
# API keys are kept strictly on the agent side and NEVER exposed to the frontend.
# Options: mock, openai, nvidia, ollama
YANA_AI_PROVIDER=mock
YANA_AI_API_KEY=
# Custom base URL (e.g., https://integrate.api.nvidia.com/v1 or http://localhost:11434/v1)
YANA_AI_BASE_URL=
YANA_AI_MODEL=gpt-4o-mini
YANA_AI_MAX_TOKENS=2048
YANA_AI_TEMPERATURE=0.7

# --- Voice Subsystem (TTS) ---
# Text-to-speech provider. Options: edge_tts (default, keyless), cartesia, mock
YANA_TTS_PROVIDER=edge_tts
# edge_tts voice (used when YANA_TTS_PROVIDER=edge_tts)
YANA_TTS_VOICE=en-US-AriaNeural

# Cartesia (Sonic) TTS — speak in a custom/cloned voice.
# Set YANA_TTS_PROVIDER=cartesia to activate. Get an API key and clone a voice
# in the Cartesia dashboard (https://play.cartesia.ai), then paste the voice ID.
YANA_CARTESIA_API_KEY=
YANA_CARTESIA_VOICE_ID=
# model_id and Cartesia-Version are env-overridable (Cartesia revises them over time).
YANA_CARTESIA_MODEL=sonic-2
YANA_CARTESIA_VERSION=2024-11-13
YANA_CARTESIA_BASE_URL=https://api.cartesia.ai

# --- Security & Permissions ---
# Safety mode: strict (requires confirmation for medium/high/critical tools) or permissive
YANA_PERMISSION_MODE=strict
# Maximum continuous tool execution loops to prevent infinite cycles
YANA_MAX_EXECUTION_LOOPS=10
# Timeout for tool execution in seconds
YANA_TOOL_TIMEOUT_SECONDS=30

# --- Desktop Window Settings ---
YANA_DESKTOP_WIDTH=420
YANA_DESKTOP_HEIGHT=680
