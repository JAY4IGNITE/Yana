# ============================================
# YANA - Version Control Exclusions
# ============================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# Operating System Files
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.swo
*~

# Node & Frontend dependencies
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
coverage/

# Rust & Tauri
apps/desktop/src-tauri/target/
target/
**/*.rs.bk
*.pdb

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
*.egg-info/
.eggs/

# SQLite & Data Storage
*.db
*.db-journal
*.db-wal
*.db-shm
data/
storage/

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Log files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tauri generated assets
apps/desktop/src-tauri/gen/
